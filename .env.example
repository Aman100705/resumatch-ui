# ===========================================
# ResuMatch UI — Environment Variables
# ===========================================

# ---- DEMO MODE ----
# Set to "true" to run the UI without a backend.
# All data is stored in localStorage (resets if you clear browser data).
# Set to "false" when you want to connect to the real Spring Boot backend.
NEXT_PUBLIC_DEMO_MODE=true

# ---- BACKEND URL (only used when DEMO_MODE=false) ----
NEXT_PUBLIC_API_URL=http://localhost:8080
